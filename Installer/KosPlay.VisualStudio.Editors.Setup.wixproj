<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputName>KosPlay.VisualStudio.Editors.VS18</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <Cultures>en-US</Cultures>
    <PayloadDirectory>$(MSBuildProjectDirectory)\obj\$(Configuration)\Extension</PayloadDirectory>
    <DefineConstants>$(DefineConstants);PayloadDirectory=$(PayloadDirectory)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
    <ProjectReference Include="..\VisualStudio.Editors\KosPlay.VisualStudio.Editors.csproj" />
    <ProjectReference Include="..\InstallerCustomActions\KosPlay.Installer.CustomActions.csproj" />
  </ItemGroup>
  <Target Name="PrepareExtensionFiles" BeforeTargets="CoreCompile" DependsOnTargets="ResolveProjectReferences">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Prepare-Payload.ps1&quot; -Configuration $(Configuration) -Destination &quot;$(PayloadDirectory)&quot;" />
  </Target>
</Project>